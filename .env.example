# Razorpay Dashboard -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=create-a-long-random-secret

# Used to sign secure download links
DOWNLOAD_SECRET=create-another-long-random-secret

# Public URL of your deployed website
SITE_URL=https://yourdomain.com

# Resend (or leave blank to skip automatic email delivery)
RESEND_API_KEY=re_xxxxxxxxx
FROM_EMAIL=Gain Yourself <you@yourdomain.com>
